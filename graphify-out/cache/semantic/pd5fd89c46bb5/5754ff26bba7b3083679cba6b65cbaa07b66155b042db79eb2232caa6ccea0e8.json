type": "code", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_autherror", "label": "Auth Error Message Box (id=authError)", "file_type": "code", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_interruptible_alert_design", "label": "Interruptible Crash-Alert Interface Design", "file_type": "rationale", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A crash alert that can't be quickly cancelled by a conscious rider is a system that will eventually be ignored; the sealed abort button, buzzer and status LED make the countdown legible and interruptible, usable with a glove on."}, {"id": "index_weatherproofing_precondition", "label": "Weatherproofing as a Precondition, Not a Feature", "file_type": "rationale", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weatherproofing isn't a feature, it's a precondition \u2014 a device that fails in the rain fails on exactly the kind of day a rider is most likely to need it."}, {"id": "index_no_phone_dependency", "label": "Phone-Independent Alerting (No Phone in the Loop)", "file_type": "rationale", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The ESP32-S3 runs the entire device independently, with no phone in the loop, so the alert path never depends on the rider's phone being present, charged, or intact."}, {"id": "index_power_spike_continuity", "label": "Power Continuity Through the Transmission Spike", "file_type": "rationale", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transmitting over the mobile network draws a hard current spike the instant it fires; this stage exists so the moment of the alert is never the moment the device gives out."}, {"id": "index_no_app_no_login_design", "label": "No App, No Login, No Excess (Bystander Lookup Design)", "file_type": "rationale", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bystander lookup opens in any phone's camera or browser with no app, no login and no relationship to the rider required, showing only triage-critical fields so the rest of the record stays private."}], "edges": [{"source": "index_page", "target": "index_giacomo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": null, "weight": 1.0}, {"source": "index_page", "target": "index_apparatus_section", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": null, "weight": 1.0}, {"source": "index_page", "target": "index_sequence_section", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": null, "weight": 1.0}, {"source": "index_page", "target": "index_scan_section", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": null, "weight": 1.0}, {"source": "index_page", "target": "index_registry_section", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": null, "weight": 1.0}, {"source": "index_page", "target": "index_audiences_section", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": null, "weight": 1.0}, {"source": "index_page", "target": "index_assembly_explod