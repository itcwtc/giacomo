 null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_pcb", "label": "4-Layer Custom PCB", "file_type": "concept", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_enclosure", "label": "ASA/PETG 3D-Printed Enclosure", "file_type": "concept", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_gaskets", "label": "Silicone Gaskets / O-Rings (IP67 Sealing)", "file_type": "concept", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_piezo_buzzer", "label": "Piezo Buzzer (Alert)", "file_type": "concept", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_ws2812b_led", "label": "WS2812B RGB LED (Status Indicator)", "file_type": "concept", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_abort_button", "label": "Waterproof Momentary Push Button (Manual Abort)", "file_type": "concept", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_antennas", "label": "U.FL/SMA Antennas (LTE + GNSS)", "file_type": "concept", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_inmp441", "label": "INMP441 I2S MEMS Microphone", "file_type": "concept", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_max98357a", "label": "MAX98357A I2S Class-D Amplifier", "file_type": "concept", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_microsd", "label": "MicroSD Module (Black-Box Storage)", "file_type": "concept", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_rationale_section", "label": "Engineering Rationale, by Subsystem", "file_type": "document", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_sensing_rationale", "label": "On-Chip MLC Crash Classification", "file_type": "rationale", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Crash detection runs on the IMU's own machine-learning core (MLC) rather than in ESP32 application code, for lower latency (no round trip through the main CPU/scheduler) and lower power (the ESP32 stays low-activity while the IMU watches motion continuously, waking the main processor only when a likely crash is flagged)."}, {"id": "manual_connectivity_rationale", "label": "Phone-Independent Cellular Alerting", "file_type": "rationale", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The alert path deliberately does not depend on a paired phone; an on-device cellular modem means the crash notification goes out even if the rider's phone is destroyed, dead, or simply not on them."}, {"id": "manual_positioning_rationale", "label": "Multi-Constellation GNSS Positioning", "file_type": "rationale", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multi-constellation GNSS (GPS/GLONASS/Galileo/BeiDou) trades a small amount of extra power draw for a materially faster, more reliable fix under tree cover, between buildings, or in road cuts and overpasses common on motorcycle routes."}, {"id": "manual_local_record_rationale", "label": "Local Black-Box Impact Logging", "file_type": "rationale", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The seconds immediately before and after an impact are logged locally regardless of whether the cellular alert succeeds, so a recoverable record survives even if network conditions fail exactly when they're needed most."}, {"id": "manual_power_rationale", "label": "PMIC Transmission-Spike Protection", "file_type": "rationale", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The power management IC keeps the board's supply stable through the sharp current spike the instant the cellular modem keys up, so the exact moment the device needs to send its alert is never the moment it browns out."}, {"id": "manual_enclosure_rationale", "label": "Interruptible Crash-Alert Interface Design", "file_type": "rationale", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A crash alert a conscious rider can't quickly cancel is a system people learn to distrust and eventually disable; the sealed abort button, audible buzzer and status LED make the countdown legible and interruptible, usable with a glove on, in the rain, by someone who may be disoriented."}, {"id": "manual_methodology_section", "label": "Research Methodology (Placeholder)", "file_type": "document", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_validation_section", "label": "Crash-Detection Validation Results (Placeholder)", "file_type": "document", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_comparison_section", "label": "Comparison Against Existing Solutions (Placeholder)", "file_type": "document", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manual_cardo_packtalk_pro", "label": "Cardo Packtalk Pro (Competitor Product)", "file_type": "concept", "source_file": "manual.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "manual_page", "target": "manual_bom_section", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manual.html", "source_location": null, "weight": 1.0}, {"source": "manual_page", "target": "manual_rationale_section", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manual.html", "source_location": null, "weight": 1.0}, {"source": "manual_page", "target": "manual_methodology_section", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manual.html", "source_location": null, "weight": 1.0}, {"source": "manual_page", "target": "manual_validation_section", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manual.html", "source_location": null, "weight": 1.0}, {"source": "manual_page", "target": "manual_comparison_section", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manual.html", "source_location": null, "weight": 1.0}, {"source": "manual_bom_section", "target": "manual_esp32_s3_wroom_1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "manual.html", "source_location": null, "weight": 1.0}, {"source": "manual_bom_section", "target": "manual_lsm6dsox"